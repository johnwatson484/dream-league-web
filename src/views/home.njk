{% extends '_layout.njk' %}

{% block content %}
<div class="jumbotron">
  <h1>Dream League</h1>
  <p>Private fantasy football league</p>
</div>

{% if results.gameweekId %}
<div class="row">
  <div class="col-md-6" style="padding-bottom: 20px;">
    <div class="card border-dark">
      <div class="card-header bg-dark text-light">
        Latest scores - Week {{ results.gameweekId }}
      </div>
      <div class="card-body">
        {% include "./_scores.njk" %}
      </div>
    </div>
  </div>
  <div class="col-md-6" style="padding-bottom: 20px;">
    <div class="card border-dark">
      <div class="card-header bg-dark text-light">
        Table
      </div>
      <div class="card-body">
        {% include "./_table.njk" %}
      </div>
    </div>
  </div>
</div>

{% if results.cupScores.length %}
<div class="row">
  <div class="col-md-6" style="padding-bottom: 20px;">
    <div class="card border-dark">
      <div class="card-header bg-dark text-light">
        Cup results
      </div>
      <div class="card-body">
        {% include "./_cup-scores.njk" %}
      </div>
    </div>
  </div>
</div>
{% endif %}

{% if results.groups.length %}
<div class="row">
  {% for group in results.groups %}
  <div class="col-md-6" style="padding-bottom: 20px;">
    <div class="card border-dark">
      <div class="card-header bg-dark text-light">
        Group {{ loop.index }}
      </div>
      <div class="card-body">
        {% include "./_group.njk" %}
      </div>
    </div>
  </div>
  {% endfor %}
</div>
{% endif %}

<div class="row">
  <div class="col-md-6" style="padding-bottom: 20px;">
    <div class="card border-dark">
      <div class="card-header bg-dark text-light">
        Form
      </div>
      <div class="card-body">
        {% include "./_form.njk" %}
      </div>
    </div>
  </div>
  <div class="col-md-6" style="padding-bottom: 20px;">
    <div class="card border-dark">
      <div class="card-header bg-dark text-light">
        Top Scorers
      </div>
      <div class="card-body">
        {% include "./_top-scorers.njk" %}
      </div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-md-6" style="padding-bottom: 20px;">
    <h3>Finances</h3>
    <p>Visit <a href="https://www.dreamleaguefinance.co.uk" target="_blank">www.dreamleaguefinance.co.uk<i
          class="fa fa-external-link" aria-hidden="true"></i></a> to manage your Dream League finances.</p>
  </div>
  <div class="col-md-6" style="padding-bottom: 20px;">
    <h3>Next meeting</h3>
    {% if nextMeeting.date %}
    <p>The next transfer meeting is {{ nextMeeting.date }}.</p>
    {% else %}
    <p>No meetings scheduled</p>
    {% endif %}
  </div>
</div>

<div class="row">
  <div class="col-md-6" style="padding-bottom: 20px;">
    <img class="img-fluid rounded" src="/assets/images/money.jpeg" />
  </div>
  <div class="col-md-6" style="padding-bottom: 20px;">
    <img class="img-fluid rounded" src="/assets/images/beer.jpeg" />
  </div>
</div>
{% else %}

{% if upcoming.seasonStartDate %}
<div class="row">
  <div class="col-md-6" style="padding-bottom: 20px;">
    <div class="card border-dark">
      <div class="card-header bg-dark text-light">
        Season Countdown
      </div>
      <div class="card-body text-center">
        <p class="lead mb-2">The new season starts <strong>{{ upcoming.seasonStartDate | longDate }}</strong></p>
        <div id="countdown" class="d-flex justify-content-center"></div>
      </div>
    </div>
  </div>
</div>
{% endif %}

{% if upcoming.managers.length %}
<div class="row">
  <div class="col-md-6" style="padding-bottom: 20px;">
    <div class="card border-dark">
      <div class="card-header bg-dark text-light">
        Managers
      </div>
      <div class="card-body">
        <div class="row">
          {% for manager in upcoming.managers %}
          <div class="col-6 col-md-4 col-lg-3 mb-2">
            <span class="badge badge-secondary p-2 w-100">{{ manager.name }}</span>
          </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>
{% endif %}

{% if upcoming.lastSeason %}
<div class="row">
  <div class="col-md-6" style="padding-bottom: 20px;">
    <div class="card border-dark">
      <div class="card-header bg-dark text-light">
        Last Season's Winners ({{ upcoming.lastSeason.year }})
      </div>
      <div class="card-body">
        <div class="row text-center">
          {% if upcoming.lastSeason.league1 %}
          <div class="col-md-4 mb-3">
            <i class="fa fa-trophy fa-2x text-warning"></i>
            <h6 class="mt-2">League</h6>
            <p class="font-weight-bold">{{ upcoming.lastSeason.league1 }}</p>
          </div>
          {% endif %}
          {% if upcoming.lastSeason.cup %}
          <div class="col-md-4 mb-3">
            <i class="fa fa-trophy fa-2x text-info"></i>
            <h6 class="mt-2">Cup</h6>
            <p class="font-weight-bold">{{ upcoming.lastSeason.cup }}</p>
          </div>
          {% endif %}
          {% if upcoming.lastSeason.leagueCup %}
          <div class="col-md-4 mb-3">
            <i class="fa fa-trophy fa-2x text-success"></i>
            <h6 class="mt-2">League Cup</h6>
            <p class="font-weight-bold">{{ upcoming.lastSeason.leagueCup }}</p>
          </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>
{% endif %}

{% if upcoming.nextMeeting %}
<div class="row">
  <div class="col-md-6" style="padding-bottom: 20px;">
    <div class="card border-dark">
      <div class="card-header bg-dark text-light">
        Next Meeting
      </div>
      <div class="card-body">
        <p>The next transfer meeting is <strong>{{ upcoming.nextMeeting.date | longDate }}</strong>.</p>
      </div>
    </div>
  </div>
</div>
{% endif %}

{% if upcoming.seasonStartDate %}
<script>
(function () {
  var target = new Date('{{ upcoming.seasonStartDate }}').getTime()
  var container = document.getElementById('countdown')

  function pad (n) { return n < 10 ? '0' + n : n }

  function render () {
    var now = Date.now()
    var diff = target - now

    if (diff <= 0) {
      container.innerHTML = '<h3 class="text-success">The season has started!</h3>'
      return
    }

    var days = Math.floor(diff / 86400000)
    var hours = Math.floor((diff % 86400000) / 3600000)
    var minutes = Math.floor((diff % 3600000) / 60000)
    var seconds = Math.floor((diff % 60000) / 1000)

    container.innerHTML =
      '<div class="mx-2 text-center"><h2>' + days + '</h2><small>days</small></div>' +
      '<div class="mx-2 text-center"><h2>' + pad(hours) + '</h2><small>hours</small></div>' +
      '<div class="mx-2 text-center"><h2>' + pad(minutes) + '</h2><small>mins</small></div>' +
      '<div class="mx-2 text-center"><h2>' + pad(seconds) + '</h2><small>secs</small></div>'
  }

  render()
  setInterval(render, 1000)
})()
</script>
{% endif %}

{% endif %}
{% endblock %}
